<Page x:Class="WpfApp1.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="HomePage"
      >

    <Grid
        Background="WhiteSmoke">
        <TextBox HorizontalAlignment="Left" Height="42" Margin="34,10,0,0" TextWrapping="Wrap" Text="Módulo de Planta" VerticalAlignment="Top" Width="251"
                 FontSize="30" BorderThickness="0"/>
        <TextBox HorizontalAlignment="Left" Height="42" Margin="34,64,0,0" TextWrapping="Wrap" Text="Elige una opción para continuar" VerticalAlignment="Top" Width="714"
            FontSize="20" BorderThickness="0"/>
        <Border BorderBrush="Black" HorizontalAlignment="Left" Height="114" Margin="34,0,0,0" VerticalAlignment="Center" Width="215" CornerRadius="10,10,10,10" BorderThickness="1,1,1,1">
            <Button Content="Ir" HorizontalAlignment="Center" Height="26" Margin="0,68,0,0" VerticalAlignment="Top" Width="181"
                   Click="Button_Click" />
        </Border>
        <TextBox HorizontalAlignment="Left" Height="27" Margin="94,184,0,0" TextWrapping="Wrap" Text="Insertar" VerticalAlignment="Top" Width="96"
            FontSize="20" BorderThickness="0" FontWeight="Bold" TextAlignment="Center"/>
        <Border BorderBrush="Black" HorizontalAlignment="Left" Height="114" Margin="284,0,0,0" VerticalAlignment="Center" Width="214" CornerRadius="10,10,10,10" BorderThickness="1,1,1,1">
            <Button Content="Ir" HorizontalAlignment="Center" Height="26" Margin="0,68,0,0" VerticalAlignment="Top" Width="181"
                    />
        </Border>
        <TextBox HorizontalAlignment="Left" Height="27" Margin="330,184,0,0" TextWrapping="Wrap" Text="Actualizar" VerticalAlignment="Top" Width="108"
            FontSize="20" BorderThickness="0" FontWeight="Bold" TextAlignment="Center" RenderTransformOrigin="0.5,0.5">
            <TextBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.405"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBox.RenderTransform>
        </TextBox>
        <Border BorderBrush="Black" HorizontalAlignment="Left" Height="114" Margin="533,0,0,0" VerticalAlignment="Center" Width="215" CornerRadius="10,10,10,10" BorderThickness="1,1,1,1">
            <Button Content="Ir" HorizontalAlignment="Center" Height="26" Margin="0,68,0,0" VerticalAlignment="Top" Width="181"
                    />
        </Border>
        <TextBox HorizontalAlignment="Left" Height="27" Margin="592,184,0,0" 
            TextWrapping="Wrap" Text="Buscar" 
            VerticalAlignment="Top" Width="96"
            FontSize="20" BorderThickness="0" FontWeight="Bold" TextAlignment="Center"/>

    </Grid>
</Page>
