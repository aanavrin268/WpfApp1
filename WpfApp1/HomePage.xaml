<Page x:Class="WpfApp1.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d"
      Title="HomePage">
    <Grid Background="WhiteSmoke"
          ShowGridLines="True">
        <!-- Definir filas y columnas para un diseño responsivo -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Títulos -->
            <RowDefinition Height="Auto"/>
            <!-- Subtítulo -->
            <RowDefinition Height="*"/>
            <!-- Área de botones -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Título principal -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" 
                   Text="Módulo de Planta" 
                   FontSize="30" 
                   HorizontalAlignment="Center" 
                   Margin="10"/>

        <!-- Subtítulo -->
        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" 
                   Text="Elige una opción para continuar" 
                   FontSize="20" 
                   HorizontalAlignment="Center" 
                   Margin="10"/>

        <!-- Botón Insertar -->
        <Border Grid.Row="2" Grid.Column="0" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="10" 
                Margin="10"
                Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Insertar" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           TextAlignment="Center" 
                           Margin="0,0,0,10"/>
                <Button Content="Ir" 
                        Width="150" 
                        Height="26" 
                        Click="Button_Click"/>
            </StackPanel>
        </Border>

        <!-- Botón Actualizar -->
        <Border Grid.Row="2" Grid.Column="1" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="10" 
                Margin="10"
                Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Actualizar" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           TextAlignment="Center" 
                           Margin="0,0,0,10"/>
                <Button Content="Ir" 
                        Width="150" 
                        Height="26"/>
            </StackPanel>
        </Border>

        <!-- Botón Buscar -->
        <Border Grid.Row="2" Grid.Column="2" 
                BorderBrush="Black" 
                BorderThickness="1" 
                CornerRadius="10" 
                Margin="10"
                Background="Transparent">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Buscar" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           TextAlignment="Center" 
                           Margin="0,0,0,10"/>
                <Button Content="Ir" 
                        Click="goToSearch"
                        Width="150" 
                        Height="26"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>