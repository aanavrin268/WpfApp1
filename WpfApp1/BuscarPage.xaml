<Page x:Class="WpfApp1.BuscarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d"
      Background="#e6e6e6"
      xmlns:converters="clr-namespace:WpfApp1"
      Title="BuscarPage">

    <Page.Resources>
        <converters:BooleanToVisibilityConverter
            x:Key="BoolToVis"
            TrueVaue="Visible"
            FalseValue="Collapsed"
            />
        <converters:BooleanToVisibilityConverter
            x:Key="InvertedBoolToVis"
            TrueVaue="Collapsed"
            FalseValue="Visible"
            />
    </Page.Resources>


    <Grid
       ShowGridLines="False">
        <Grid.RenderTransform>
            <TranslateTransform X="0" Y="0" />
        </Grid.RenderTransform>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"
                  />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

     <!-- FIRST ROW -->
        
        <Border
            Grid.Row="0" Grid.Column="0"
            BorderBrush="#cccccc"
            BorderThickness="1"
            Margin="10"
            Padding="10"
            Background="White"
            CornerRadius="12">

            <Grid
                ShowGridLines="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="8*" />

                </Grid.RowDefinitions>

                <TextBlock
                    Text="Datos de la OP"
                    Grid.Row="0"
                    FontSize="17"
                    FontWeight="Medium"
                    />
                <TextBlock
                     Text="Llena todos los valores correspondientes a la OP que deseas ingresar."
                     Grid.Row="1"
                    HorizontalAlignment="Left"
VerticalAlignment="Top"
                    FontSize="13"
                     />

                <Grid
                    ShowGridLines="False"
                    Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>
                    
                    

                    <ComboBox x:Name="cb_nombre" 
                      SelectionChanged="CbNombre_SelectionChanged"
                      Grid.Column="0"
                      Grid.Row="0"
                      Width="200" 
                      Height="30" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Panel.ZIndex="1"/>

                    <Label Content="Nombre:" 
                           Grid.Row="0"
                           Grid.Column="0"
                       FontWeight="Medium"
                      Foreground="#424242"
                           FontSize="13"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="0,-50,0,0" 
                       Panel.ZIndex="2"/>

                    <ComboBox x:Name="cb_id" 
                      Grid.Column="1"
                                                    Grid.Row="0"

                      Width="200" 
                      Height="30" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Panel.ZIndex="1"/>

                    <Label Content="Id Sistema:" 
                       Grid.Column="1"
                                                 Grid.Row="0"

                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                             FontWeight="Medium"
                 Foreground="#424242"
                      FontSize="13"
                   Margin="0,-50,0,0" 
                   Panel.ZIndex="2"/>


                    <ComboBox x:Name="cb_empresa" 
                       Grid.Column="2"
                                                    Grid.Row="0"

                       Width="200" 
                       Height="30" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"/>

                    <Label Content="Empresa:" 
                            Grid.Column="2"
                                                 Grid.Row="0"

                        HorizontalAlignment="Center" 
                             FontWeight="Medium"
                     Foreground="#424242"
                          FontSize="13"
                        VerticalAlignment="Center" 
                        Margin="0,-50,0,0" 
                        Panel.ZIndex="2"/>

                    <TextBox
                           x:Name="tb_unidades"
                        Grid.Column="3"
                        Grid.Row="0"
                        Width="200"
                        Height="30"
                        Panel.ZIndex="1"
                        HorizontalAlignment="center"
                        VerticalAlignment="Center"
                        />
                    <Label
                        Content="Cantidad de unidades"
                        Grid.Column="3"
                        Grid.Row="0"
                          FontWeight="Medium"
                     Foreground="#424242"
                          FontSize="13"
                        HorizontalAlignment="center"
                        VerticalAlignment="center"
                        Margin="0, -50, 0, 0"
                        Panel.ZIndex="2"
                        />

            <!--  
                    
                      <DatePicker
                          x:Name="dp_op"
                          Grid.Row="1"
                          Grid.Column="0"
                          Width="200"
                          Height="30"
                          HorizontalAlignment="center"
                          VerticalAlignment="center"
                          Panel.ZIndex="1"
                          />
                    
                                       <Label
                     Content="Fecha  OP"
                     Grid.Column="1"
                     Grid.Row="1"
                     HorizontalAlignment="center"
                     VerticalAlignment="center"
                     Margin="0, -50, 0, 0"
                         FontWeight="Medium"
                    Foreground="#424242"
                         FontSize="13"
                     Panel.ZIndex="2"
                     />
                    
                    
                    -->
                  

                    <Label
                         
                         Content="Fecha Plan"
                         Grid.Column="0"
                         Grid.Row="1"
                          FontWeight="Medium"
                     Foreground="#424242"
                          FontSize="13"
                         HorizontalAlignment="center"
                         VerticalAlignment="center"
                         Margin="0, -50, 0, 0"
                         Panel.ZIndex="2"
                         />




                    <DatePicker
                         x:Name="dp_plan"
                         Grid.Row="1"
                         Grid.Column="0"
                         SelectedDateChanged="dp_plan_SelectedDateChanged"
                         Width="200"
                         Height="30"
                         HorizontalAlignment="center"
                         VerticalAlignment="center"
                         Panel.ZIndex="1"
                         />     

                   

                 

              

                    <Button
                        x:Name="btn_save"
                        Grid.Row="2"
                        Click="SaveRegister"
                        Grid.Column="3"
                        Content="Agregar"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        />

                    <Button
                         x:Name="btn_cancel"
                        Click="onCancel"
                         Grid.Row="2"
                         Grid.Column="3"
                         Content="Cancelar"
                         Width="100"
                         Height="40"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         />






                </Grid>
                
                
                
            </Grid>
        </Border>

        
 <!-- ROW 1 - COL 1 -->
        <Border
           Grid.Row="0" Grid.Column="1"
            BorderBrush="#cccccc"
            BorderThickness="1"
            Margin="10"
            Background="White"
            Padding="10"
            CornerRadius="12">

            <Grid
                >

                <Grid
                    ShowGridLines="True"
                    Visibility="{Binding EsVisible, Converter={StaticResource BoolToVis}}"
                    >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="4*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                         Text="Arribos Verdadero"
                         Grid.Row="0"
                         FontSize="17"
                        
                         Grid.ColumnSpan="2"
                         />



                    <TextBlock
                         Text="Agrega o modifica los arribos de la OP."
                         Grid.Row="1"
                         Grid.ColumnSpan="2"
                         />
                    
                    <!-- COMBO BOX DE SELECCION DE ARRIBO  -->

                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Text="Selección de Folio"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="0, -50, 0, 0"
                        Panel.ZIndex="2"
                        />

                    <ComboBox x:Name="cb_arribo" 
                              Grid.ColumnSpan="2"
                      ItemsSource="{Binding Source={x:Static local:AppData.currentOP}, Path=Arribos}"
                      DisplayMemberPath="Folio"
                      SelectedValuePath="Folio"
                      SelectionChanged="CbArribo_SelectionChanged"
                      Grid.Row="2"
                     Width="200"
                     Height="30"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Panel.ZIndex="1"
                              />
                    
                 

                    <!-- DATA GRID-->

                    <DataGrid 
                        x:Name="dtg_buscar"
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        ItemsSource="{Binding Source={x:Static local:AppData.currentOP}, Path=Arribos}"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False">     
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="70"/>
                            <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="70"/>
                            <DataGridTextColumn Header="Estatus" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Causal" Binding="{Binding Causal}" Width="200"/>
                            <DataGridTextColumn Header="Ini. Fabrica" Binding="{Binding EnvioFabrica}" Width="100"/>
                            <DataGridTextColumn Header="Fin Fabrica" Binding="{Binding AduanaAnalisis}" Width="100"/>
                            <DataGridTextColumn Header="F. Almacen" Binding="{Binding FechaAlmacen}" Width="100"/>

                        </DataGrid.Columns>
                    </DataGrid>


                    <Button
                         x:Name="btn_new_arribo"
                         Click="AddNewArribo"
                         Content="Nuevo"
                         Grid.Row="4"
                         Grid.Column="1"
                         Width="80"
                         Height="30"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Left"
                         />

                        <Button
                           x:Name="btn_na_terminar"
                           Click="onInsertRegister"
                           Content="Terminar"
                           Grid.Row="4"
                           Grid.Column="1"
                           Width="80"
                           Height="30"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           />

                    <TextBlock
                        Text=""
                        />

                </Grid>

                <Grid
                    ShowGridLines="True"
                    Visibility="{Binding EsVisible, Converter={StaticResource InvertedBoolToVis}}"
                >

                    <Viewbox Stretch="Uniform" MaxWidth="300">
                        <TextBlock
                             Text="Agrega una OP para modificar sus arribos."
                             VerticalAlignment="center"
                             HorizontalAlignment="Center"
                             FontSize="30"
                            Foreground="#424242"
                            FontWeight="DemiBold"
                              TextWrapping="Wrap"
                             />

                    </Viewbox>

                   


                </Grid>

            </Grid>

          
        </Border>
        
 <!-- ROW 2 COLSPAN 2 -->

        <Border
            Grid.Row="1"
            Grid.ColumnSpan="2"
            BorderBrush="#cccccc"
            BorderThickness="1"
            Background="White"
              Margin="10"
              Padding="10"
              CornerRadius="12"
            >

            
            <Grid
                ShowGridLines="False"
                >
                <Grid.RowDefinitions>
                    <RowDefinition Height="2.5*" />
                    <RowDefinition Height="7.5*" />

                </Grid.RowDefinitions>
                
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="8*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                
                
                <!-- FIRST ROW  -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Vista Previa"
                    FontSize="17"
                    FontWeight="Medium"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    />

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    FontSize="14"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Left"
                    Text="Lista de productos de la OP."
                    />

                <!-- FIRST COLUMN -->

                <DataGrid
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0, 10, 5, 0"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    ItemsSource="{Binding Source={x:Static local:AppData.ListaOps}}"
                    >        
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="150" />
                        <DataGridTextColumn Header="ID Sistema" Binding="{Binding Id_Sistema}" Width="100" />
                        <DataGridTextColumn Header="Empresa" Binding="{Binding Empresa}" Width="260" />
                        <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="100" />
                        <DataGridTextColumn Header="Fecha de planeación" Binding="{Binding Fecha_Plan}" Width="130" />

                    </DataGrid.Columns>
                </DataGrid>





                <!--  SECOND COLUMN  -->

                <Button
                    x:Name="btn_finalizar"
                    Grid.Row="1"
                    Grid.Column="1"
                    Click="onFinishTask"
                    Content="Finalizar Alta"
                    Width="100"
                    Height="30"
                    Padding="5"
                    Margin="10"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    />


            </Grid>
         </Border>


    </Grid>
</Page>
