<Page x:Class="WpfApp1.BuscarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d"
      Title="BuscarPage">

    <Grid
       ShowGridLines="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="7*"
                  />
            <RowDefinition Height="3*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Row="0" Grid.Column="0"
            BorderBrush="Black"
            BorderThickness="2"
            Margin="20"
            Padding="10"
            CornerRadius="12">

            <Grid
                ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="8*" />

                </Grid.RowDefinitions>

                <TextBlock
                    Text="Datos de la OP"
                    Grid.Row="0"
                    />
                <TextBlock
                     Text="Llena todos los valores correspondientes a la OP que deseas ingresar."
                     Grid.Row="1"
                     />

                <Grid
                    ShowGridLines="True"
                    Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />

                    </Grid.RowDefinitions>
                    
                    

                    <ComboBox x:Name="cb_nombre" 
                      SelectionChanged="CbNombre_SelectionChanged"
                      Grid.Column="0"
                      Grid.Row="0"
                      Width="200" 
                      Height="30" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Panel.ZIndex="1"/>

                    <Label Content="Nombre:" 
                                             Grid.Row="0"

                           Grid.Column="0"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center" 
                       Margin="0,-50,0,0" 
                       Panel.ZIndex="2"/>

                    <ComboBox x:Name="cb_id" 
                      Grid.Column="1"
                                                    Grid.Row="0"

                      Width="200" 
                      Height="30" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      Panel.ZIndex="1"/>

                    <Label Content="Id Sistema:" 
                       Grid.Column="1"
                                                 Grid.Row="0"

                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Margin="0,-50,0,0" 
                   Panel.ZIndex="2"/>


                    <ComboBox x:Name="cb_empresa" 
                       Grid.Column="2"
                                                    Grid.Row="0"

                       Width="200" 
                       Height="30" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"
                       Panel.ZIndex="1"/>

                    <Label Content="Empresa:" 
                            Grid.Column="2"
                                                 Grid.Row="0"

                        HorizontalAlignment="Center" 
                        VerticalAlignment="Center" 
                        Margin="0,-50,0,0" 
                        Panel.ZIndex="2"/>

                    <TextBox
                           x:Name="tb_unidades"
                        Grid.Column="3"
                        Grid.Row="0"
                        Width="200"
                        Height="30"
                        Panel.ZIndex="1"
                        HorizontalAlignment="center"
                        VerticalAlignment="Center"
                        />
                    <Label
                        Content="# de Unidades"
                        Grid.Column="3"
                        Grid.Row="0"
                        HorizontalAlignment="center"
                        VerticalAlignment="center"
                        Margin="0, -50, 0, 0"
                        Panel.ZIndex="2"
                        />


                    <DatePicker
                        x:Name="dp_op"
                        Grid.Row="1"
                        Grid.Column="0"
                        Width="200"
                        Height="30"
                        HorizontalAlignment="center"
                        VerticalAlignment="center"
                        Panel.ZIndex="1"
                        />

                    <Label
                         
                         Content="Fecha Plan"
                         Grid.Column="0"
                         Grid.Row="1"
                         HorizontalAlignment="center"
                         VerticalAlignment="center"
                         Margin="0, -50, 0, 0"
                         Panel.ZIndex="2"
                         />




                    <DatePicker
                         x:Name="dp_plan"
                         Grid.Row="1"
                         Grid.Column="1"
                         SelectedDateChanged="dp_plan_SelectedDateChanged"
                         Width="200"
                         Height="30"
                         HorizontalAlignment="center"
                         VerticalAlignment="center"
                         Panel.ZIndex="1"
                         />     

                    <Label
                      Content="Fecha  OP"
                      Grid.Column="1"
                      Grid.Row="1"
                      HorizontalAlignment="center"
                      VerticalAlignment="center"
                      Margin="0, -50, 0, 0"
                      Panel.ZIndex="2"
                      />

                    <Button
                        x:Name="btn_save"
                        Grid.Row="2"
                        Click="SaveRegister"
                        Grid.Column="3"
                        Content="Agregar"
                        Width="100"
                        Height="40"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        />

                    <Button
                         x:Name="btn_cancel"
                        Click="onCancel"
                         Grid.Row="2"
                         Grid.Column="3"
                         Content="Cancelar"
                         Width="100"
                         Height="40"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         />






                </Grid>
                
                
                
            </Grid>
        </Border>
        <Rectangle
            Grid.Row="1"
            Fill="red"
            />


    </Grid>
</Page>
