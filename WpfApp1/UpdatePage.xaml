<Page x:Class="WpfApp1.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
     
      Title="UpdatePage">

    <Page.Resources>
        <local:CountToStringConverter x:Key="CountConverter" />
    </Page.Resources>


    <Grid
        ShowGridLines="True">

        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="6*" />

        </Grid.RowDefinitions>

    <!-- ROW 0 -->
        <Border
            Grid.Row="0"
            Padding="10">
            <Grid
                ShowGridLines="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                
         <!--- FIRST COLUMN -->

                <TextBlock 
                    Grid.Row="0"
                    Text="Actualizar OP"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    FontSize="25px"
                    FontWeight="Bold"
                    />

                <TextBlock 
                 Grid.Row="1"
                 Text="Ingresa un Folio o un número de OP para buscar sus datos."
                 VerticalAlignment="Center"
                 HorizontalAlignment="Left"
                    FontSize="16"
                 /> 
                
      
                
            </Grid>
        </Border>
        
    <!-- ROW 1 -->
        <Border
            Grid.Row="1"
            Padding="10">
            <Grid
                ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                
           <!---COLUMN 0  -->

                <UniformGrid 
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Columns="3">
                    <TextBlock
                        Text="Número de Folio/OP: "
                        Margin="0, 0, 30, 0"
                        />
                    <TextBox
                        x:Name="tb_input"
                        KeyDown="tb_input_Keydown"
                        />

                    <Button
                        x:Name="btn_search"
                        Content="Buscar"
                        Margin="0, 0, 30, 0"
                        Click="onSearchFormatted"
                        />

                </UniformGrid>
                
            <!-- COLUMN1 -->

                <!--- ROW 0  -->
                <Border
              Grid.Column="1"
              Grid.Row="1"
                    Padding="10"
              Background="#F3F3F3"
                    CornerRadius="10"
              >

                    <Grid
                        ShowGridLines="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />

                        </Grid.RowDefinitions>
                        
                        <!--- ROW 0 -->
                        <TextBlock
                            Text="Folio: "
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#434343"
                            />

                        <Label
                            x:Name="lb_folio"
                            Content="{Binding Source={x:Static local:Reactividad.Instance}, Path=neoOp.FolioOp}"                           
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="40, 0, 0,0"
                            Background="Blue"
                            Foreground="White"
                            FontWeight="Medium">
                        </Label>

                        <TextBlock
                             Text="Número de orden: "
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#434343"
                            Margin="0, 0, 60, 0"
                             />

                        <Label
                            Content="NA"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Background="Green"
                            Foreground="White"
                            FontWeight="Medium"
                            ></Label>


                        <!-- ROW 1  -->

                        <TextBlock
                            Grid.Row="1"
                            Text="Dada de alta el "
                            HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="#434343"
                            />

                        <Label 
                            x:Name="lb_date"
                            Grid.Row="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="100, 0, 0, 0"
                            Content="26/05/2025"
                            FontSize="16"
                            FontWeight="DemiBold"
                            ></Label>

                    </Grid>

                </Border>
                


            </Grid>
        </Border>


        <!--- ROW 3 -->

        <Border
                 Grid.Row="3"
                 Padding="10"
                 >

            <Grid
                     ShowGridLines="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />

                </Grid.ColumnDefinitions>
               
            <!--- COLUMN 0 -->

                <Border
                    Grid.Column="0"
                    Padding="10"
                    Background="White"
                    Margin="5"
                    CornerRadius="10"
                    >
                    <Grid
                        ShowGridLines="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" />
                            <RowDefinition Height="7*" />

                        </Grid.RowDefinitions>
                        
                        
                    <!--- ROW 0 -->
                        <StackPanel
                          Grid.Row="0"
                          Orientation="Vertical"
                          >
                            <TextBlock
                                x:Name="kk"
                                HorizontalAlignment="Right"
                                Text="{Binding Source={x:Static local:Reactividad.Instance}, Path=neoOp.Products.Count, Converter={StaticResource CountConverter}}"
                                />

                            <TextBlock
                                Text="Selecciona un producto para ver su información  y sus arribos."
                                />

                            <StackPanel
                                Orientation="Horizontal"
                                Margin="0, 10, 0, 0"
                                >
                                <ComboBox
                                    x:Name="cb_folios"
                                    Width="200"
                                    ></ComboBox>
                                <Button
                                    Margin="20, 0, 0, 0"
                                    Content="Ver"
                                    Width="50"
                                    Height="30"
                                    ></Button>
                                
                            </StackPanel>


                        </StackPanel>   
                        
                    <!-- ROW 1 -->
                        <Border
                            Grid.Row="1"
                            Background="#f3f3f3"
                            >
                            <Grid
                                ShowGridLines="True"
                                >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>


                                <!-- ROW 0 -->
                                <!-- COL 0 -->

                                    <StackPanel
                                Grid.Row="0"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                >

                                    <TextBlock
                                    Text="Nombre"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                    />

                                    <Label
                                        Content="es nombre"
                                        HorizontalAlignment="Right"
                                        Margin="20, 0, 0, 0"
                                     VerticalAlignment="Center"

                                        >
                                        
                                    </Label>

                                </StackPanel>

                                <!-- ROW 0 -->
                                <!-- COL 1 -->

                                    <StackPanel
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   Orientation="Horizontal"
                                       VerticalAlignment="Center"
                                   >

                                    <TextBlock
                                       Text="Id.Sistema"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                       />

                                    <Label
                                       Content="es PT10032"
                                       HorizontalAlignment="Right"
                                       Margin="20, 0, 0, 0"
                                    VerticalAlignment="Center"

                                       >    

                                    </Label>

                                </StackPanel>

                                <!-- ROW 1 -->
                                <!-- COL 0 -->

                                    <StackPanel
                                     Grid.Row="1"
                                     Grid.Column="0"
                                     Orientation="Horizontal"
                                         VerticalAlignment="Center"
                                     >

                                    <TextBlock
                                         Text="Empresa"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                         />

                                    <Label
                                         Content="es sdsd"
                                         HorizontalAlignment="Right"
                                         Margin="20, 0, 0, 0"
                                      VerticalAlignment="Center"

                                         >  

                                    </Label>

                                </StackPanel>

                                <!-- ROW 1 -->
                                <!-- COL 1 -->

                                    <StackPanel
                                  Grid.Row="1"
                                  Grid.Column="1"
                                  Orientation="Horizontal"
                                      VerticalAlignment="Center"
                                  >

                                    <TextBlock
                                      Text="Unidades"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                      />    

                                    <Label
                                      Content="es 1000000"
                                      HorizontalAlignment="Right"
                                      Margin="20, 0, 0, 0"
                                   VerticalAlignment="Center"

                                         >

                                    </Label>

                                </StackPanel>


                                <!-- ROW 2 -->
                                <!-- COL 0 -->

                                    <StackPanel
                                   Grid.Row="2"
                                   Grid.Column="0"
                                   Orientation="Horizontal"
                                       VerticalAlignment="Center"
                                         >

                                    <TextBlock
                                       Text="Fecha Plan"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                                    />

                                        <Label
                                           Content="es 0/0/0"
                                           HorizontalAlignment="Right"
                                           Margin="20, 0, 0, 0"
                                        VerticalAlignment="Center"

                                            >

                                    </Label>

                                </StackPanel>


                                <!-- ROW 2 -->
                                <!-- COL  1 -->

                                <StackPanel
                                     Grid.Row="2"
                                     Grid.Column="1"
                                     Orientation="Horizontal"
                                         VerticalAlignment="Center"
                                        >

                                    <TextBlock
                                         Text="Fecha OP"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                        />

                                    <Label
                                         Content="es 0/0/0"
                                         HorizontalAlignment="Right"
                                         Margin="20, 0, 0, 0"
                                      VerticalAlignment="Center"

                                         >

                                    </Label>

                                </StackPanel>

                            </Grid>
                            
                          
                            
                            
                            
                        </Border>
                        
                    </Grid>

                  
                    
                    
                </Border>
                
                
            <!-- COLUMN 1 -->
                <DataGrid
                    x:Name="myDataGrid"
                    Grid.Column="1"
                    ItemsSource="{Binding Source={x:Static local:AppData.currentOP}, Path=Arribos, Mode=OneWay}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False">
                    
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio" Binding="{Binding Folio}" Width="80" />
                        <DataGridTextColumn Header="Unidades" Binding="{Binding Unidades}" Width="70"/>
                        <DataGridTextColumn Header="Estatus" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Causal" Binding="{Binding Causal}" Width="200"/>
                        <DataGridTemplateColumn Header="Estatus" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Status}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox 
                                    ItemsSource="{Binding Source={x:Static local:Readebles.StatusList}}"
                                        SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                        IsEditable="True"/>     
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>


              
            </Grid>

        </Border>

    </Grid>
</Page>
