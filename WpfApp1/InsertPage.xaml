<Page x:Class="WpfApp1.InsertPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp1"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="InsertPage">

    <Grid
        Background="White">
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="305" Margin="26,10,0,0" VerticalAlignment="Top" Width="464">

            <Grid Margin="0,0,-1,0">
                <Button Content="Button" HorizontalAlignment="Left" Height="27" Margin="350,266,0,0" VerticalAlignment="Top" Width="91"/>
                <ComboBox 
                    x:Name="cb_nombre"
                    SelectionChanged="CbNombre_SelectionChanged"

                    HorizontalAlignment="Left" Height="30" Margin="64,13,0,0" VerticalAlignment="Top" Width="124"/>
                <Label Content="Nombre" HorizontalAlignment="Left" Height="24" Margin="10,13,0,0" VerticalAlignment="Top" Width="54"/>
                <Label Content="ID Sistema" HorizontalAlignment="Left" Height="24" Margin="246,16,0,0" VerticalAlignment="Top" Width="66"/>
                <ComboBox 
                    x:Name="cb_id"
                    HorizontalAlignment="Left" Height="30" Margin="316,12,0,0" VerticalAlignment="Top" Width="124"/>

            </Grid>

        </Border>


        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="305" Margin="520,10,0,0" VerticalAlignment="Top" Width="257"/>
        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" Height="92" Margin="26,337,0,0" VerticalAlignment="Top" Width="545"/>
        <Button Content="Cancelar" HorizontalAlignment="Left" Height="28" Margin="590,401,0,0" VerticalAlignment="Top" Width="88"/>
        <Button Content="Guardar " HorizontalAlignment="Left" Height="28" Margin="689,401,0,0" VerticalAlignment="Top" Width="88"/>

    </Grid>
</Page>
