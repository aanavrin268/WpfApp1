<Window x:Class="WpfApp1.ArriboModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Height="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Title="Nuevo Arribo"  Width="400">
    <Grid
        ShowGridLines="True"
        >
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="6*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Padding="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Text="Escribe la cantidad de unidades para el nuevo arribo"
            />

        <TextBox
            x:Name="tb_na_units"
            Grid.Row="1"
            Padding="10"
            Height="40"
            Width="300"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            />

        <Button
          x:Name="btn_na_cancel"
          Content="Cancelar"
            Click="onCancel"
          Grid.Row="2"
          Padding="5"
          Margin="0, 0, 80, 0"
          HorizontalAlignment="Right"
          VerticalAlignment="Center"
          />

        <Button
            x:Name="btn_na_save"
            Content="Guardar"
            Click="onSave"
            Grid.Row="2"
            Padding="5"
            Margin="0, 0, 10, 0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            />
    </Grid>
</Window>
